/target
.DS_Store

# Golden fixtures + captured transcripts live in the private claude-replay-eval
# repo, NOT here — they may contain real Claude session content. Never commit.
/golden/
*.jsonl
/design/sample-transcript-data.js
/examples/sample-agent-monitor.html

# …and the same hazard from the other direction: `--dump` writes its render beside you as
# <stem>.txt + <stem>.ansi, `--dump --json` writes <stem>.json, `--dump-html` writes
# <stem>.html. Run any of them from the repo root — which is exactly where you run the
# binary while working on it — and a transcript's CONTENT lands here as an untracked file
# that `git add -A` will happily commit. One did.
/*.txt
/*.ansi
/*.json
/*.html

# Scratch / internal artifacts (analysis notes, autonomous-run briefs, comparison
# tooling) — not part of the tracked source; may embed real session paths/ids.
/claude-tasks-*.md
/COMPARE-FINDINGS.md
/COMPARE-CC-vs-peek-TASK.md
/DIAGNOSIS-visual-parity.md
/capture-peek.sh
/compare-scroll.py
/stitch-frames.py
.claude/worktrees/
